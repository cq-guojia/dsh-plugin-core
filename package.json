{
  "name": "dsh-plugin-core",
  "version": "0.0.0",
  "description": "Shared base for DSH plugins: design tokens, UI controls, utils, workspace explorer, session preview",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin"
  ],
  "homepage": "https://github.com/cq-guojia/dsh-plugin-core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cq-guojia/dsh-plugin-core.git"
  },
  "author": "cq-guojia",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./design": {
      "types": "./dist/design/index.d.ts",
      "default": "./dist/design/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./explorer": {
      "types": "./dist/explorer/index.d.ts",
      "default": "./dist/explorer/index.js"
    },
    "./explorer/preview": {
      "types": "./dist/explorer/preview/index.d.ts",
      "default": "./dist/explorer/preview/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "default": "./dist/session/index.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "dist",
    "docs",
    "!dist/client.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/plugin-client-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "demo:build": "node demo/build.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-rc.2",
    "@types/react": "^18.3.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
