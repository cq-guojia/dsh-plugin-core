    "./ui/pagination-logic": { "types": "./dist/ui/navigation/pagination-logic.d.ts", "default": "./dist/ui/navigation/pagination-logic.js" }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "gen:css": "node scripts/gen-css.mjs",
    "build": "node scripts/gen-css.mjs && node scripts/gen-docs.mjs && tsc -p tsconfig.json && node scripts/prune-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.demo.json --noEmit",
    "typecheck:demo": "tsc -p tsconfig.demo.json --noEmit",
    "pretest": "node scripts/gen-css.mjs --check && node scripts/gen-docs.mjs --check && tsc -p tsconfig.json && tsc -p tsconfig.demo.json --noEmit && node tools/host-upgrade-diff/scripts/diff.mjs --self-check && node tools/host-upgrade-diff/scripts/diff.mjs --contract-check",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "pnpm run build && pnpm test",
    "typecheck:docs": "tsc -p tsconfig.docs.json",
    "gen:docs": "node scripts/gen-docs.mjs",
    "build:demo": "node packages/demo/build.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
