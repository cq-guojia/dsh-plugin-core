    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin"
  ],
  "homepage": "https://github.com/cq-guojia/dsh-plugin-core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cq-guojia/dsh-plugin-core.git"
  },
  "author": "cq-guojia",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/ui/official.js"],
  "exports": {
    "./package.json": "./package.json",
    "./design": { "types": "./dist/design/index.d.ts", "default": "./dist/design/index.js" },
    "./utils": { "types": "./dist/utils/index.d.ts", "default": "./dist/utils/index.js" },
