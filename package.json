{
  "name": "dsh-plugin-core",
  "version": "0.35.23",
  "packageManager": "pnpm@12.3.4",
  "description": "Shared base for DSH plugins: design tokens, UI controls, utils, workspace explorer, session preview",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin"
  ],
  "homepage": "https://github.com/cq-guojia/dsh-plugin-core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cq-guojia/dsh-plugin-core.git"
  },
  "author": "cq-guojia",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./design": {
      "types": "./dist/design/index.d.ts",
      "default": "./dist/design/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui/official": {
      "types": "./dist/ui/official.d.ts",
      "default": "./dist/ui/official.js"
    },
    "./ui/code-viewer": {
      "types": "./dist/ui/display/code-viewer.d.ts",
      "default": "./dist/ui/display/code-viewer.js"
    },
    "./ui/host-toast": {
      "types": "./dist/ui/feedback/host-toast.d.ts",
      "default": "./dist/ui/feedback/host-toast.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./adv/explorer": {
      "types": "./dist/adv/explorer/index.d.ts",
      "default": "./dist/adv/explorer/index.js"
    },
    "./adv/explorer/preview": {
      "types": "./dist/adv/explorer/preview/index.d.ts",
      "default": "./dist/adv/explorer/preview/index.js"
    },
    "./adv/session": {
      "types": "./dist/adv/session/index.d.ts",
      "default": "./dist/adv/session/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "gen:css": "node scripts/gen-css.mjs",
    "build": "node scripts/gen-css.mjs && node scripts/gen-docs.mjs && tsc -p tsconfig.json && node scripts/prune-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.demo.json --noEmit",
    "typecheck:demo": "tsc -p tsconfig.demo.json --noEmit",
    "pretest": "node scripts/gen-css.mjs --check && node scripts/gen-docs.mjs --check && tsc -p tsconfig.json && tsc -p tsconfig.demo.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "pnpm run build && pnpm test",
    "typecheck:docs": "tsc -p tsconfig.docs.json",
    "gen:docs": "node scripts/gen-docs.mjs",
    "build:demo": "node packages/demo/build.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@floating-ui/react": "^0.27.20",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
